# Aggregated secret placeholders for the projects in this repo, grouped by project.
# Copy the lines you need into your Home Assistant secrets.yaml and fill in real values.
# secrets.yaml itself is git-ignored and must never be committed.

# --- Discogs → Sonos Jukebox (projects/discogs-jukebox) ---
# Discogs user token — https://www.discogs.com/settings/developers
discogs_token: YOUR_DISCOGS_USER_TOKEN
